{
  "_doc": "Hooks configuration for dashboard-af. Combines ClaudeKit Engineer (14 hooks via cjs scripts) + 4 AF-specific prompt-based hooks adapted from saas-agents pattern.",
  "SessionStart": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-init.cjs",
          "timeout": 30
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/team-context-inject.cjs",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/af-roadmap-check.cjs",
          "timeout": 15
        }
      ]
    }
  ],
  "SubagentStart": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-init.cjs",
          "timeout": 15
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/dev-rules-reminder.cjs",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-context-awareness.cjs",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/descriptive-name.cjs",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/cook-after-plan-reminder.cjs",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/scout-block.cjs",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/privacy-block.cjs",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/af-deps-guard.cjs",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-simplify-reminder.cjs",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/af-task-tracker.cjs",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/af-productivity-logger.cjs",
          "timeout": 15
        }
      ]
    }
  ],
  "TaskCompleted": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/task-completed-handler.cjs",
          "timeout": 15
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/teammate-idle-handler.cjs",
          "timeout": 15
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-state.cjs",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/af-stop-checkpoint.cjs",
          "timeout": 20
        }
      ]
    }
  ]
}
