{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_doc": "Project-level settings for dashboard-esden. Permissions allowlist is intentionally minimal — extend only when needed. Hooks are auto-registered from .claude/hooks/hooks.json by the esden-agents plugin.",
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git check-ignore:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run test:*)",
      "Bash(npm test)",
      "Bash(npm audit:*)",
      "Bash(npm outdated)",
      "Bash(npm ls:*)",
      "Bash(npm info:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx next:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:developers.hubspot.com)",
      "WebFetch(domain:zoho.com)",
      "WebSearch",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_click",
      "mcp__plugin_playwright_playwright__browser_type",
      "mcp__plugin_playwright_playwright__browser_wait_for",
      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__plugin_playwright_playwright__browser_close"
    ],
    "deny": [
      "Bash(git push:*main*)",
      "Bash(git push:*staging*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git remote add origin:*renzo1111ia*)",
      "Bash(git remote set-url origin:*renzo1111ia*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*.env*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)"
    ]
  },
  "model": "inherit",
  "effortLevel": "high"
}
