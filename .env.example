# ============================================================================
# .env.example — dashboard-af
# ============================================================================
# COPIA ESTE ARCHIVO A `.env.local` (gitignored) Y RELLENA CON VALORES REALES.
# Los secretos reales se reparten por canal seguro (Easypanel env vars, vault,
# 1Password). NUNCA commitees `.env` real al repositorio.
# ============================================================================

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL self-hosted — VPS Dokploy o local Docker)
# -----------------------------------------------------------------------------
# OBLIGATORIAS — tras Sprint 0 tarea 1-04, ya NO hay fallback hardcoded en el
# código. Si cualquiera de estas falta, la app lanzará Error explícito al
# arrancar (helper src/lib/env.ts: requireEnv / requireEnvAny).
#
# ARQUITECTURA path-prefix (decidida 23-05-2026):
#   - VPS: NEXT_PUBLIC_SUPABASE_URL=https://dev.automatizaformacion.com/supabase
#     Traefik elimina /supabase y enruta a supabase-kong:8000 internamente.
#     Same-origin con la app → cero CORS + cookies compartidas SSR↔client.
#   - LOCAL: NEXT_PUBLIC_SUPABASE_URL=http://localhost:8500/supabase
#     Next.js rewrite (next.config.ts) proxy /supabase/* → kong:8100.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8500/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...REPLACE_ME_ONLY_FOR_ADMIN_SCRIPTS
# SUPABASE_URL (server-only, opcional pero recomendado en VPS para reducir hops):
#   - VPS: misma URL pública (loop a tu propio traefik, evita problema DNS interno Swarm)
#   - LOCAL: directo a kong para evitar el loop por Next.js
SUPABASE_URL=http://127.0.0.1:8100
# SUPABASE_KONG_INTERNAL_URL — destino del rewrite Next.js (LOCAL only).
# Default: http://127.0.0.1:8100. Si cambias el puerto de Supabase, ajusta aquí.
# SUPABASE_KONG_INTERNAL_URL=http://127.0.0.1:8100
# Connection string Postgres directo (uso legacy / scripts de admin / SQL migrations Supabase)
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.example.com:5432/postgres

# -----------------------------------------------------------------------------
# Auth / Sessions
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=REPLACE_ME_GENERATE_WITH_openssl_rand_-base64_32
NEXTAUTH_URL=http://localhost:8500

# -----------------------------------------------------------------------------
# LLM providers (LangChain multi-LLM)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME
GOOGLE_GENAI_API_KEY=AIza...REPLACE_ME

# -----------------------------------------------------------------------------
# Voice providers
# -----------------------------------------------------------------------------
RETELL_API_KEY=key_REPLACE_ME
# Secret HMAC-SHA256 que Retell usa para firmar los webhooks (1-12, 1-13).
# Validar firma en `x-retell-signature`. Obtener desde Retell Dashboard.
RETELL_WEBHOOK_SECRET=REPLACE_ME
ULTRAVOX_API_KEY=REPLACE_ME
ULTRAVOX_WEBHOOK_SECRET=REPLACE_ME

# WhatsApp Cloud API (Meta) — tarea 1-14
# WHATSAPP_APP_SECRET ahora OBLIGATORIO: la firma HMAC `x-hub-signature-256` se
# valida siempre. Sin esta env var el endpoint /api/webhooks/whatsapp responde 503.
WHATSAPP_APP_SECRET=REPLACE_ME_FROM_META_APP_DASHBOARD
# Token usado en el GET de verificación de webhook de Meta (antes hardcoded).
WHATSAPP_VERIFY_TOKEN=REPLACE_ME_RANDOM_STRING

# -----------------------------------------------------------------------------
# CRM integrations — MVP Fase 2 (HubSpot + Zoho)
# -----------------------------------------------------------------------------

# Base pública de la app — usada para construir redirect_uri de OAuth.
# LOCAL: http://localhost:8500. VPS: https://dev.automatizaformacion.com.
# Si no se define, los routes /api/integrations/*/auth construirán la URL
# leyendo `request.headers.host` (fallback). Recomendado fijarlo explícito.
NEXT_PUBLIC_APP_URL=http://localhost:8500

# Secret para firmar `state` del flow OAuth (anti-CSRF + carry tenant_id).
# HMAC-SHA256(tenantId + ':' + nonce, OAUTH_STATE_SECRET) → cookie httpOnly 15min.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Formato: 43 chars base64url (32 bytes). NUNCA commitear el valor real.
OAUTH_STATE_SECRET=REPLACE_ME_GENERATE_WITH_node_crypto_randomBytes_32_base64url

# HubSpot Public App (multi-tenant OAuth2) — registrar app en
# https://developers.hubspot.com/ → Manage Apps → Create App.
# Scopes mínimos (verificar en developer portal antes de Phase 03):
#   crm.objects.contacts.read crm.objects.contacts.write
#   crm.schemas.contacts.read crm.objects.deals.read crm.lists.write
#   crm.objects.tasks.write crm.objects.meetings.write
HUBSPOT_CLIENT_ID=REPLACE_ME
HUBSPOT_CLIENT_SECRET=REPLACE_ME
HUBSPOT_REDIRECT_URI=http://localhost:8500/api/integrations/hubspot/callback

# Zoho OAuth2 — registrar app en https://api-console.zoho.com/ (Server-based).
# IMPORTANTE: la consola de Zoho está vinculada al DC donde se creó la cuenta;
# el adapter detecta automáticamente el DC del cliente final desde el
# parámetro `accounts-server` del callback OAuth (multi-DC support).
# Scopes granulares mínimos:
#   ZohoCRM.modules.leads.READ,WRITE
#   ZohoCRM.modules.contacts.READ,WRITE
#   ZohoCRM.modules.tasks.WRITE
#   ZohoCRM.modules.events.WRITE
#   ZohoCRM.settings.fields.READ
#   ZohoCRM.bluepoints.READ
ZOHO_CLIENT_ID=REPLACE_ME
ZOHO_CLIENT_SECRET=REPLACE_ME
ZOHO_REDIRECT_URI=http://localhost:8500/api/integrations/zoho/callback
# DC por defecto si el adapter NO puede inferir DC del callback (fallback raro).
# El valor real `api_domain` viene en cada token response y se persiste en
# `integrations.metadata.api_domain` por cada conexión activa.
ZOHO_API_DOMAIN=https://www.zohoapis.eu

# -----------------------------------------------------------------------------
# Fase 4 (post-release) — Google Sheets / Salesforce / GHL / ActiveCampaign
# -----------------------------------------------------------------------------
# Estas variables se rellenan cuando lleguemos a Fase 4. Dejarlas vacías ahora.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SALESFORCE_CLIENT_ID=
# GHL_CLIENT_ID=
# ACTIVECAMPAIGN_API_KEY=

# -----------------------------------------------------------------------------
# Queue / Worker (BullMQ + Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# -----------------------------------------------------------------------------
# Cron secret (Sprint 0 tarea 1-08)
# -----------------------------------------------------------------------------
# Secret compartido con el sistema que dispara los endpoints cron (sweep,
# reminders). Se valida vía header `x-cron-secret` o `Authorization: Bearer`.
# Generar con: openssl rand -base64 48
CRON_SECRET=REPLACE_ME_GENERATE_WITH_openssl_rand_-base64_48

# -----------------------------------------------------------------------------
# Cifrado AES-256-GCM tokens OAuth (Sprint 1 tarea 2-26, ADR-017)
# -----------------------------------------------------------------------------
# Cifra credenciales OAuth de integraciones CRM (HubSpot/Zoho/Google Sheets/etc.)
# antes de persistir en `public.integrations.credentials_cipher`.
# Algoritmo: AES-256-GCM (autenticado). Helper: src/lib/crypto/token-crypto.ts.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Formato: 64 chars hex (32 bytes). NUNCA commitear la clave real.
# Rotación: cambiar valor + reproceso (TODO formato v2: en Sprint v0.5.x).
ENCRYPTION_KEY=REPLACE_ME_GENERATE_WITH_node_crypto_randomBytes_32_hex

# -----------------------------------------------------------------------------
# Observabilidad / logging (Sprint 3 phase-02)
# -----------------------------------------------------------------------------
# Pino logger level: trace | debug | info | warn | error | fatal | silent
# Prod: info. Dev: debug.
LOG_LEVEL=info

# Sentry — error tracking (plan free 5K errores/mes). Crear proyecto en sentry.io
# y pegar el DSN aquí. Si vacío, Sentry queda deshabilitado en runtime (no se inicializa).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project_id>
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project_id>   # mismo valor; expuesto al browser

# Sentry source maps upload (solo CI/Dokploy build): si presentes, los releases incluyen
# source maps reales para mostrar stack traces sin minificar. Si vacíos, los errores
# Sentry muestran código minificado pero siguen capturándose.
# SENTRY_ORG=automatiza-formacion
# SENTRY_PROJECT=dashboard-af
# SENTRY_AUTH_TOKEN=sntrys_xxxxx   # NUNCA committear; setearlo en Dokploy build args

# OpenTelemetry (post-MVP Sprint 4, deshabilitado por defecto)
# OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Build metadata (Dokploy lo inyecta como --build-arg; sirve /api/version)
# -----------------------------------------------------------------------------
# GIT_COMMIT_SHA=                  # set automáticamente por Dokploy build
# GIT_BRANCH=                      # set automáticamente por Dokploy build
# BUILD_TIMESTAMP=                 # set automáticamente por Dokploy build (ISO8601)

# -----------------------------------------------------------------------------
# Feature flags / dev flags
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
# Habilitar voice provider A/B testing (Retell vs Ultravox)
FEATURE_VOICE_PROVIDER_AB=false
