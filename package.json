{
  "name": "af-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8500",
    "build": "next build",
    "start": "next start -p 8500",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "db:up": "npx supabase start",
    "db:down": "npx supabase stop",
    "db:status": "npx supabase status",
    "db:reset": "npx supabase db reset",
    "db:seed-demo": "npx tsx scripts/seed-demo.ts",
    "redis:up": "docker-compose -f docker-compose.dev.yml up -d",
    "redis:down": "docker-compose -f docker-compose.dev.yml down",
    "local:setup": "npm run db:up && npm run redis:up && npm run db:seed-demo",
    "local:teardown": "npm run db:down && npm run redis:down",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1031.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1031.0",
    "@aws-sdk/client-s3": "^3.1031.0",
    "@aws-sdk/s3-request-presigner": "^3.1031.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/openai": "^1.4.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@types/pg": "^8.20.0",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.16.1",
    "bullmq": "^5.73.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "countries-and-timezones": "^3.9.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "langchain": "^1.2.39",
    "libphonenumber-js": "^1.12.42",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.15.0",
    "next": "^16.2.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "redis": "^5.11.0",
    "remark-gfm": "^4.0.1",
    "retell-sdk": "^5.12.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.143",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.12.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "msw": "^2.14.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
