#!/usr/bin/env sh
# commit-msg hook — dashboard-af
# Valida formato Conventional Commits + bloquea co-autoría de IA.

commit_msg_file="$1"
commit_msg="$(cat "$commit_msg_file")"

# 1) Bloquear co-autoría IA (regla global del usuario).
if echo "$commit_msg" | grep -Eqi 'co-authored-by:.*(claude|anthropic|copilot|gpt|openai|cursor|ai-assistant|noreply@anthropic\.com)'; then
  echo ""
  echo "ERROR: co-autoría de IA detectada en el commit."
  echo "  Política del proyecto: NUNCA Claude/Anthropic/IA como co-autor."
  echo "  Co-autores humanos sí están permitidos."
  echo ""
  exit 1
fi

# 2) Validar formato Conventional Commits.
#    Tipos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.
#    Permite scope opcional: feat(api): ...
#    Permite ! para breaking change: feat(api)!: ...
first_line="$(printf '%s' "$commit_msg" | head -n1)"
conv_regex='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,}'

# Permitir merge/revert automáticos de git.
case "$first_line" in
  Merge*|Revert*|"fixup!"*|"squash!"*) exit 0 ;;
esac

if ! echo "$first_line" | grep -Eq "$conv_regex"; then
  echo ""
  echo "ERROR: mensaje de commit no sigue Conventional Commits."
  echo "  Recibido: $first_line"
  echo ""
  echo "  Formato esperado: <tipo>(<scope>): <descripción>"
  echo "  Tipos válidos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "  Ejemplos:"
  echo "    feat(adapter): añadir HubSpot OAuth2 flow"
  echo "    fix(rls): cerrar bypass en policy de tenants"
  echo "    chore: bump dependencies"
  echo ""
  exit 1
fi
